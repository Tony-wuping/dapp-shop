import { NextResponse } from "next/server";
import { prisma } from "@/lib/prisma";

function serializeOrder(order: any) {
  return {
    id: order.id.toString(),
    orderNo: order.orderNo,
    userId: order.userId.toString(),
    walletAddress: order.walletAddress,
    nickname: order.nickname,
    productId: order.productId.toString(),
    productName: order.productName,
    productPrice: order.productPrice.toString(),
    coinType: order.coinType,
    chainType: order.chainType,
    payAddress: order.payAddress,
    orderStatus: order.orderStatus,
    createdAt: order.createdAt ? order.createdAt.toISOString() : "",
    paidAt: order.paidAt ? order.paidAt.toISOString() : "",
    completedAt: order.completedAt ? order.completedAt.toISOString() : "",
    timeoutAt: order.timeoutAt ? order.timeoutAt.toISOString() : "",
    shippingInfo: order.shippingInfo || "",
    remark: order.remark || "",
  };
}

export async function GET(req: Request) {
  try {
    const { searchParams } = new URL(req.url);
    const query = searchParams.get("query")?.trim() || "";
    const status = searchParams.get("status")?.trim() || "";

    const where: any = {};

    if (query) {
      where.OR = [
        { orderNo: { contains: query } },
        { walletAddress: { contains: query } },
        { nickname: { contains: query } },
        { productName: { contains: query } },
        { coinType: { contains: query } },
        { chainType: { contains: query } },
        { payAddress: { contains: query } },
      ];
    }

    if (status && status !== "all") {
      where.orderStatus = status;
    }

    const orders = await prisma.order.findMany({
      where,
      orderBy: { createdAt: "desc" },
    });

    return NextResponse.json({
      success: true,
      data: orders.map(serializeOrder),
    });
  } catch (error) {
    console.error(error);
    return NextResponse.json(
      { success: false, message: "获取订单列表失败" },
      { status: 500 }
    );
  }
}